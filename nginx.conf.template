user root;
worker_processes auto;
error_log /dev/stderr warn;
pid /run/nginx/nginx.pid;

events { worker_connections 1024; }

http {
  include       /etc/nginx/mime.types;
  default_type  application/octet-stream;
  access_log    off;
  sendfile      on;
  keepalive_timeout 65;
  client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};
  proxy_read_timeout 3600s;
  proxy_send_timeout 3600s;

  # Railway's internal DNS hands out a fresh IPv6 address whenever an upstream
  # service is redeployed, so the upstream host has to be a variable and has to
  # be re-resolved. A variable upstream suppresses nginx's location-prefix
  # rewrite and drops the query string, so every proxy_pass below passes
  # $request_uri verbatim rather than a URI of its own.
  resolver ${NGINX_RESOLVER} valid=10s ipv6=on;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
  }

  server {
    listen ${NGINX_PORT} default_server;
    server_name _;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;

    location = /healthz {
      access_log off;
      return 200 "ok\n";
    }

    location /console/api { set $u "${API_UPSTREAM}"; proxy_pass $u$request_uri; }
    location /api         { set $u "${API_UPSTREAM}"; proxy_pass $u$request_uri; }
    location /v1          { set $u "${API_UPSTREAM}"; proxy_pass $u$request_uri; }
    location /openapi     { set $u "${API_UPSTREAM}"; proxy_pass $u$request_uri; }
    location /files       { set $u "${API_UPSTREAM}"; proxy_pass $u$request_uri; }
    location /mcp         { set $u "${API_UPSTREAM}"; proxy_pass $u$request_uri; }
    location /triggers    { set $u "${API_UPSTREAM}"; proxy_pass $u$request_uri; }

    location /socket.io/ {
      set $u "${API_UPSTREAM}";
      proxy_pass $u$request_uri;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
    }

    # Plugin daemon webhook endpoints. Dify-Hook-Url tells the daemon which
    # public URL a plugin hook was reached on.
    location /e/ {
      set $u "${PLUGIN_UPSTREAM}";
      proxy_pass $u$request_uri;
      proxy_set_header Dify-Hook-Url $scheme://$host$request_uri;
    }

    location / {
      proxy_pass http://127.0.0.1:3000$request_uri;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
    }
  }
}
