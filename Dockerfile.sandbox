# Dify code sandbox with its literal configuration baked in.
#
# A Railway template variable whose default is a literal is dropped at generate
# time and publishes as a blank required field, so the only literals a listing
# can ship are the ones inside an image.
FROM langgenius/dify-sandbox:0.2.15

ENV GIN_MODE=release \
    WORKER_TIMEOUT=15 \
    ENABLE_NETWORK=true \
    SANDBOX_PORT=8194
