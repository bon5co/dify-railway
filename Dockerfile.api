# Dify API + Celery worker + beat in one Railway service.
#
# Railway volumes cannot be shared between services, and Dify's default
# storage backend (OpenDAL fs) is a directory the API writes and the worker
# reads. Running both roles in one container is what makes that possible
# without paying for object storage.
FROM langgenius/dify-api:1.16.1

USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends gosu \
 && rm -rf /var/lib/apt/lists/*

COPY railway-api-entrypoint.sh /usr/local/bin/railway-api-entrypoint.sh
RUN chmod +x /usr/local/bin/railway-api-entrypoint.sh

# Storage lives on the Railway volume mounted here.
ENV OPENDAL_SCHEME=fs \
    STORAGE_TYPE=opendal \
    OPENDAL_FS_ROOT=/app/api/storage \
    MODE=api \
    MIGRATION_ENABLED=false \
    DIFY_BIND_ADDRESS=0.0.0.0 \
    DIFY_PORT=5001 \
    LOG_LEVEL=INFO

EXPOSE 5001
ENTRYPOINT ["/usr/local/bin/railway-api-entrypoint.sh"]

# Everything below is a literal, so it is baked here rather than published as a
# template variable: templateGenerate drops a literal defaultValue and the
# variable then reaches the deploy form as required-with-no-value.
ENV DB_TYPE=postgresql \
    DB_HOST=postgres.railway.internal \
    DB_PORT=5432 \
    DB_USERNAME=postgres \
    DB_DATABASE=dify \
    DB_PLUGIN_DATABASE=dify_plugin \
    REDIS_HOST=redis.railway.internal \
    REDIS_PORT=6379 \
    REDIS_DB=0 \
    VECTOR_STORE=pgvector \
    PGVECTOR_HOST=postgres.railway.internal \
    PGVECTOR_PORT=5432 \
    PGVECTOR_USER=postgres \
    PGVECTOR_DATABASE=dify \
    CODE_EXECUTION_ENDPOINT=http://sandbox.railway.internal:8194 \
    PLUGIN_DAEMON_URL=http://plugin-daemon.railway.internal:5002 \
    PLUGIN_REMOTE_INSTALL_HOST=plugin-daemon.railway.internal \
    PLUGIN_REMOTE_INSTALL_PORT=5003 \
    MARKETPLACE_ENABLED=true \
    MARKETPLACE_API_URL=https://marketplace.dify.ai \
    DEPLOY_ENV=PRODUCTION \
    SERVER_WORKER_AMOUNT=1 \
    CELERY_WORKER_AMOUNT=1
